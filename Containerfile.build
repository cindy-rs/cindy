FROM docker.io/rust:slim-bookworm

# cindy uses a nightly toolchain (MSRV 1.98; tier-3 worker builds need
# `-Zbuild-std`), with rustfmt/clippy for the check jobs. The wasm
# target is for the marketing site's compile check (web/).
RUN rustup toolchain install nightly --profile minimal \
        --component rustfmt,clippy \
 && rustup default nightly \
 && rustup component add rust-src \
 && rustup target add wasm32-unknown-unknown \
 && cargo install --locked cargo-audit
